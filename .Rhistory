geom_errorbarh(aes(xmin = estimate - std.error, xmax = estimate + std.error),
height = 0.2, color = "gray30") +
# Points colored by your custom species palette
geom_point(aes(color = common_name, shape = p.value < 0.05), size = 4) +
# Apply your named palette
scale_color_manual(values = my_palette, name = "Species") +
scale_shape_manual(values = c("TRUE" = 19, "FALSE" = 1),
name = "Significant (p < 0.05)") +
facet_wrap(~variable, scales = "free_x") +
theme_bw() +
labs(x = "Annual Rate of Change",
y = NULL,
subtitle = "Filled points indicate p < 0.05 (Mixed-Effects Model)") +
theme(legend.position = "right",
strip.text = element_text(face = "bold"))
library(performance) # For R-squared in mixed models
library(broom.mixed)
library(lme4)
library(lmerTest)
library(broom.mixed)
library(performance)
rigorous_results_detailed <- daily_indiv_data %>%
filter(common_name %in% power_species) %>%
split(.$common_name) %>%
map_df(~{
# 1. Determine the formula based on era coverage
# If detected in both eras, include array_design. If only one, drop it.
if(n_distinct(.x$array_design) > 1) {
form_temp  <- temperature ~ year_numeric + array_design + (1|animal_id)
form_depth <- mean_depth ~ year_numeric + array_design + (1|animal_id)
era_corrected <- "Yes"
} else {
form_temp  <- temperature ~ year_numeric + (1|animal_id)
form_depth <- mean_depth ~ year_numeric + (1|animal_id)
era_corrected <- "No"
}
# 2. Fit the models
m_temp  <- lmer(form_temp, data = .x)
m_depth <- lmer(form_depth, data = .x)
# 3. Calculate R-squared (Marginal = Fixed effects)
r2_t <- performance::r2(m_temp)
r2_d <- performance::r2(m_depth)
# 4. Tidy and combine
bind_rows(
tidy(m_temp, effects = "fixed") %>% filter(term == "year_numeric") %>%
mutate(variable = "Temp_Trend", R2_m = r2_t$R2_marginal, is_singular = isSingular(m_temp)),
tidy(m_depth, effects = "fixed") %>% filter(term == "year_numeric") %>%
mutate(variable = "Depth_Trend", R2_m = r2_d$R2_marginal, is_singular = isSingular(m_depth))
) %>%
mutate(
common_name = unique(.x$common_name),
n_fish = n_distinct(.x$animal_id),
n_obs = nrow(.x),
era_correction = era_corrected
)
})
# View the final manuscript-ready table
print(rigorous_results_detailed %>%
dplyr::select(common_name, variable, estimate, p.value, n_fish, era_correction, is_singular))
# 2. View the "Manuscript Table"
model_table_final <- rigorous_results_detailed %>%
mutate(across(where(is.numeric), ~round(., 4))) %>%
dplyr::select(common_name, estimate, std.error, p.value, n_fish, n_obs, R2_marginal, Singular)
print(model_table_final)
# 2. View the "Manuscript Table"
model_table_final <- rigorous_results_detailed %>%
mutate(across(where(is.numeric), ~round(., 4))) %>%
dplyr::select(common_name, estimate, std.error, p.value, n_fish, n_obs, R2_marginal, Singular)
# 1. Filter for a specific species (e.g., Atlantic cod)
cod_data <- daily_indiv_data %>% filter(common_name == "Atlantic cod")
m_cod_depth <- lmer(mean_depth ~ year_numeric + array_design + (1|animal_id), data = cod_data)
# 2. Plot Residuals vs. Fitted Values
# We want to see a 'random cloud' with no funnel shape
plot_data <- data.frame(
Fitted = predict(m_cod_depth),
Residuals = residuals(m_cod_depth)
)
ggplot(plot_data, aes(x = Fitted, y = Residuals)) +
geom_point(alpha = 0.5) +
geom_hline(yintercept = 0, color = "red", linetype = "dashed") +
theme_minimal() +
labs(title = "Residual Diagnostic: Atlantic cod Depth Model",
x = "Fitted Values (m)", y = "Residuals")
# 1. Extract residuals for Cod Depth
cod_m_data <- daily_indiv_data %>% filter(common_name == "Atlantic cod")
m_cod_diag <- lmer(mean_depth ~ year_numeric + array_design + (1|animal_id), data = cod_m_data)
# 2. Diagnostic Plot
diag_df <- data.frame(Fitted = predict(m_cod_diag), Residuals = residuals(m_cod_diag))
ggplot(diag_df, aes(x = Fitted, y = Residuals)) +
geom_point(alpha = 0.4, color = "steelblue") +
geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
theme_minimal() +
labs(title = "Diagnostic: Atlantic cod Depth Model",
subtitle = "Looking for a random distribution around the red line",
x = "Fitted Values (Depth m)", y = "Residuals")
