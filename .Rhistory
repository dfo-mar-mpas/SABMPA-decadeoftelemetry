print(p_final_plot)
# 1. Ensure your palette matches the number of species being plotted
# (Adjust this list if the number of species changes)
my_palette_model <- c("darkgray","#E4779C", "#800000","#49A75A", "#DCBEFF","blue")
p_final_plot <- ggplot(p_data_final, aes(x = estimate, y = axis_label)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray30", linewidth = 1) +
# Error bars (Coloured by species)
geom_errorbarh(aes(xmin = estimate - std.error, xmax = estimate + std.error, color = common_name),
height = 0.2, linewidth = 1.2) +
# Points (Filled/Open based on significance)
geom_point(aes(color = common_name, fill = significant),
shape = 21, size = 5, stroke = 1.5) +
scale_color_manual(values = my_palette_model, guide = "none") +
scale_fill_manual(name = "Significance (p < 0.05)",
values = c("TRUE" = "black", "FALSE" = "white"),
labels = c("TRUE" = "Significant", "FALSE" = "Not Significant")) +
facet_wrap(~variable, scales = "free_x") +
theme_minimal(base_size = 12) +
theme(
panel.grid.major = element_line(color = "gray90", linewidth = 0.5),
axis.line = element_line(color = "black", linewidth = 1),
strip.text = element_text(face = "bold", size = 12),
axis.title.x = element_text(margin = margin(t = 12), size = 12, face = "plain"),
axis.text.y = element_text(size = 9, color = "black", lineheight = 0.9, hjust = 1),
legend.position = "bottom"
) +
labs(x = "Annual rate of change derived from linear mixed-effects models on daily individuals", y = NULL)
# Final formatting of the results table
manuscript_table <- p_data_final %>%
mutate(
Significant = ifelse(significant == TRUE, "Yes", "No"),
Annual_Rate = round(estimate, 4),
Std_Error = round(std.error, 4),
P_Value = round(p.value, 4),
R2_Marginal = round(R2_m, 3)
) %>%
dplyr::select(common_name, variable, Annual_Rate, Std_Error, P_Value,
Significant, n_fish = n_f, n_years = n_y, total_days = t_d, R2_Marginal) %>%
arrange(variable, P_Value)
print(p_final_plot)
# Data Wrangling & Manipulation
