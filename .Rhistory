# This returns TRUE if every single row matches perfectly.
identical(sab_deploys_final$station, sab_deploys_final$STATION_NO4)
# This returns TRUE if every single row matches perfectly.
identical(sab_deploys_final$station, sab_deploys_final$STATION_NO2)
# If it returns FALSE, this code isolates and displays the specific rows where
# they differ, allowing you to see which column holds the correct data.
sab_deploys_final %>%
filter(station != STATION_NO2 | is.na(station) != is.na(STATION_NO2)) %>%
select(station, STATION_NO2) %>%
head(10)
