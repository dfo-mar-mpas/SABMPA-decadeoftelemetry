library(dplyr)
library(broom) # For tidy model outputs
library(purrr)
library(lme4)
library(lmerTest) # Adds p-values to lmer
library(ggplot2)
# ---------------------------------------------------------
# 0. Load project configuration and packages
source("code/00_setup.R")
# ---------------------------------------------------------
# ---------------------------------------------------------
# Load the data - ensure
# ---------------------------------------------------------
# read in the data if you don't have it loaded already from previous script
SAB_model_data <- readRDS("data/processed/SAB_model_data.rds")
model_ready_data <- SAB_model_data %>%
mutate(year_numeric = as.numeric(format(date_daily, "%Y")) +
(as.numeric(format(date_daily, "%j")) / 365))
species_results <- model_ready_data %>%
split(.$common_name) %>%
map_df(~{
# Only run if there is enough data (e.g., > 2 years of detections)
if(n_distinct(year(.x$date_daily)) < 2) return(NULL)
# Model A: Effect of Time on Temperature
m_temp <- lm(temperature ~ year_numeric, data = .x)
# Model B: Effect of Time on Depth
m_depth <- lm(mean_depth ~ year_numeric, data = .x)
# Extract tidy results
bind_rows(
tidy(m_temp) %>% filter(term == "year_numeric") %>% mutate(variable = "Temperature (°C/yr)"),
tidy(m_depth) %>% filter(term == "year_numeric") %>% mutate(variable = "Depth (m/yr)")
) %>%
mutate(common_name = unique(.x$common_name))
})
ggplot(species_results, aes(x = estimate, y = common_name)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
geom_errorbarh(aes(xmin = estimate - std.error, xmax = estimate + std.error), height = 0.2) +
geom_point(aes(color = p.value < 0.05), size = 3) +
facet_wrap(~variable, scales = "free_x") +
scale_color_manual(values = c("TRUE" = "firebrick", "FALSE" = "gray70"),
name = "Significant (p < 0.05)") +
theme_bw() +
labs(x = "Annual Rate of Change", y = NULL)
library(lme4)
library(lmerTest) # Adds p-values to lmer
library(dplyr)
library(purrr)
power_species <- model_ready_data %>%
group_by(common_name) %>%
summarise(n_fish = n_distinct(animal_id),
n_years = n_distinct(year(date_daily))) %>%
filter(n_fish >= 5 & n_years >= 2) %>%
pull(common_name)
rigorous_results <- model_ready_data %>%
filter(common_name %in% power_species) %>%
split(.$common_name) %>%
map_df(~{
# Model: Temperature ~ Time + (Random effect of Individual)
# (1|animal_id) accounts for individual-level bias
m_temp <- lmer(temperature ~ year_numeric + (1|animal_id), data = .x)
m_depth <- lmer(mean_depth ~ year_numeric + (1|animal_id), data = .x)
# Extract results
bind_rows(
tidy(m_temp) %>% filter(term == "year_numeric") %>% mutate(variable = "Temp_Trend"),
tidy(m_depth) %>% filter(term == "year_numeric") %>% mutate(variable = "Depth_Trend")
) %>%
mutate(common_name = unique(.x$common_name),
n_fish = n_distinct(.x$animal_id))
})
# The Random Effect prevents individual variation from tricking the model into thinking the whole species is moving into warmer water.
# Degrees of Freedom: LMMs adjust the "Degrees of Freedom" based on the number of fish, not the number of pings. This makes the p-values much more realistic.
# Effect Size: The estimate is now a "Population-Level" annual change.
# ---------------------------------------------------------
# 1. Install and load the required extension package
# ---------------------------------------------------------
# install.packages("broom.mixed")
library(broom.mixed)
# 2. Re-run your rigorous model loop
rigorous_results <- model_ready_data %>%
filter(common_name %in% power_species) %>%
split(.$common_name) %>%
map_df(~{
# Model: Temperature and Depth with Individual Random Effects
m_temp <- lmer(temperature ~ year_numeric + (1|animal_id), data = .x)
m_depth <- lmer(mean_depth ~ year_numeric + (1|animal_id), data = .x)
# broom.mixed::tidy() will now recognize the lmer objects
bind_rows(
tidy(m_temp, effects = "fixed") %>%
filter(term == "year_numeric") %>%
mutate(variable = "Temp_Trend"),
tidy(m_depth, effects = "fixed") %>%
filter(term == "year_numeric") %>%
mutate(variable = "Depth_Trend")
) %>%
mutate(common_name = unique(.x$common_name),
n_fish = n_distinct(.x$animal_id))
})
ggplot(rigorous_results, aes(x = estimate, y = common_name)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
# These error bars now represent the standard error of the population-level trend
geom_errorbarh(aes(xmin = estimate - std.error, xmax = estimate + std.error), height = 0.2) +
# Points are colored by significance (p < 0.05) using Satterthwaite's approximation
geom_point(aes(color = p.value < 0.05), size = 3) +
facet_wrap(~variable, scales = "free_x") +
scale_color_manual(values = c("TRUE" = "firebrick", "FALSE" = "gray70"),
name = "Significant (p < 0.05)") +
theme_bw() +
labs(x = "Annual Rate of Change", y = NULL)
daily_indiv_data <- model_ready_data %>%
group_by(common_name, animal_id, year_numeric, date_daily) %>%
summarise(
temperature = mean(temperature, na.rm = TRUE),
mean_depth = mean(mean_depth, na.rm = TRUE),
.groups = "drop"
)
