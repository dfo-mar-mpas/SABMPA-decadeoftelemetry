# 1. Filter the results for the 'Power Species' only
plot_data <- rigorous_results_detailed %>%
filter(common_name %in% power_species)
p_effects <- ggplot(plot_data, aes(x = estimate, y = common_name)) +
# Reference line at zero (No Annual Change)
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
# Error bars representing the Standard Error of the slope
geom_errorbarh(aes(xmin = estimate - std.error, xmax = estimate + std.error),
height = 0.2, color = "gray30") +
# Points colored by species and shaped by significance
geom_point(aes(color = common_name, shape = p.value < 0.05), size = 4) +
# Apply your custom named palette
scale_color_manual(values = my_palette, name = "Species") +
# Solid points for significant (p < 0.05), Open for non-significant
scale_shape_manual(values = c("TRUE" = 19, "FALSE" = 1),
labels = c("TRUE" = "Significant", "FALSE" = "Not Significant"),
name = "P-Value Status") +
# Separate facets for Temp and Depth with independent X-axis scales
facet_wrap(~variable, scales = "free_x",
labeller = as_labeller(c("Temp_Trend" = "Temperature Trend (°C / yr)",
"Depth_Trend" = "Depth Trend (m / yr)"))) +
theme_bw() +
labs(x = "Annual Rate of Change (Slope)",
y = NULL) +
theme(legend.position = "right",
strip.text = element_text(face = "bold", size = 10),
axis.text.y = element_text(size = 10))
print(p_effects)
library(dplyr)
library(lubridate)
library(ggplot2)
metadata_lookup <- daily_indiv_data %>%
group_by(common_name) %>%
summarise(
n_f = n_distinct(animal_id),
n_y = n_distinct(year(date_daily)),
t_d = n(),
.groups = "drop"
)
p_data_final <- rigorous_results_detailed %>%
filter(!common_name %in% c("Atlantic halibut", "American eel")) %>%
left_join(metadata_lookup, by = "common_name") %>%
mutate(
significant = p.value < 0.05,
# Create the two-line label using the joined columns
axis_label = paste0(common_name, "\n",
"n=", n_f, " | ", n_y, "yrs | ", t_d, "d total"),
variable = ifelse(variable == "Temp_Trend", "Temperature (°C / yr)", "Depth (m / yr)")
) %>%
# Alphabetical sorting
mutate(axis_label = factor(axis_label, levels = rev(sort(unique(axis_label)))))
# 1. Ensure your palette matches the number of species being plotted
# (Adjust this list if the number of species changes)
my_palette_model <- c("darkgray","#E4779C", "#800000","#49A75A", "#DCBEFF")
# 3. Plotting
p_final_plot <- ggplot(p_data_final, aes(x = estimate, y = axis_label)) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray30", linewidth = 1) +
# Error bars (Coloured by species)
geom_errorbarh(aes(xmin = estimate - std.error, xmax = estimate + std.error, color = common_name),
height = 0.2, linewidth = 1.2) +
# Points (Filled/Open based on significance)
geom_point(aes(color = common_name, fill = significant),
shape = 21, size = 5, stroke = 1.5) +
scale_color_manual(values = my_palette_model, guide = "none") +
scale_fill_manual(name = "Significance (p < 0.05)",
values = c("TRUE" = "black", "FALSE" = "white"),
labels = c("TRUE" = "Significant", "FALSE" = "Not Significant")) +
facet_wrap(~variable, scales = "free_x") +
theme_minimal(base_size = 12) +
theme(
panel.grid.major = element_line(color = "gray90", linewidth = 0.5),
axis.line = element_line(color = "black", linewidth = 1),
strip.text = element_text(face = "bold", size = 12),
axis.title.x = element_text(margin = margin(t = 12), size = 12, face = "plain"),
axis.text.y = element_text(size = 9, color = "black", lineheight = 0.9, hjust = 1),
legend.position = "bottom"
) +
labs(x = "Annual rate of change derived from linear mixed-effects models on daily individuals", y = NULL)
