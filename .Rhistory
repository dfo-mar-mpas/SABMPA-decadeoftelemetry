library(broom.mixed)
library(purrr)
rigorous_results <- daily_indiv_data %>%
filter(common_name %in% power_species) %>%
split(.$common_name) %>%
map_df(~{
# Check if the species exists in both array designs
if(n_distinct(.x$array_design) < 2) {
m_temp <- lmer(temperature ~ year_numeric + (1|animal_id), data = .x)
m_depth <- lmer(mean_depth ~ year_numeric + (1|animal_id), data = .x)
} else {
# The 'array_design' fixed effect corrects for the shift in array geometry
m_temp <- lmer(temperature ~ year_numeric + array_design + (1|animal_id), data = .x)
m_depth <- lmer(mean_depth ~ year_numeric + array_design + (1|animal_id), data = .x)
}
bind_rows(
tidy(m_temp, effects = "fixed") %>% filter(term == "year_numeric") %>% mutate(variable = "Temp_Trend"),
tidy(m_depth, effects = "fixed") %>% filter(term == "year_numeric") %>% mutate(variable = "Depth_Trend")
) %>%
mutate(common_name = unique(.x$common_name))
})
library(dplyr)
# Create a clean summary table
rigorous_summary_table <- rigorous_results %>%
mutate(
Significant = ifelse(p.value < 0.05, "Yes", "No"),
Annual_Change = round(estimate, 3),
Std_Error = round(std.error, 3),
P_Value = round(p.value, 4)
) %>%
dplyr::select(common_name, variable, Annual_Change, Std_Error, P_Value, Significant) %>%
arrange(variable, P_Value)
