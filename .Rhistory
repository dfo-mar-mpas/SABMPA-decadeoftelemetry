filter(station != STATION_NO3 | is.na(station) != is.na(STATION_NO3)) %>%
select(station, STATION_NO3)
sab_deploys_final %>%
filter(station != STATION_NO2 | is.na(station) != is.na(STATION_NO2)) %>%
select(station, STATION_NO2)
sab_deploys_final %>%
filter(station != STATION_NO4 | is.na(station) != is.na(STATION_NO4)) %>%
select(station, STATION_NO4)
sab_deploys_final %>%
filter(station != station_old | is.na(station) != is.na(station_old)) %>%
select(station, station_old)
